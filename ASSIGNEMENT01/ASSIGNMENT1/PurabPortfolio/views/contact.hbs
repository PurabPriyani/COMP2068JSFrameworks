<h1 class="contactus text-center mb-5">CONTACT ME</h1>

<div class="contact-container d-flex flex-wrap justify-content-between">

  <div class="form-container flex-fill me-lg-5 mb-4">
    {{#if errors}}
    <div class="alert alert-danger">
      <ul class="mb-0">
        {{#each errors}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    <form method="POST" action="/contact" id="contact-form">
      <div class="mb-3">
        <input type="text" name="name" value="{{form.name}}" class="form-control" placeholder="Name" required>
      </div>
      <div class="mb-3">
        <input type="email" name="email" value="{{form.email}}" class="form-control" placeholder="Email" required>
      </div>
      <div class="mb-3">
        <input type="number" name="phone" value="{{form.phone}}" class="form-control" placeholder="Phone" required>
      </div>
      <div class="mb-3">
        <textarea name="message" rows="6" class="form-control" placeholder="Message" required>{{form.message}}</textarea>
      </div>

      <div class="btn-container">
        <center><button type="submit" onclick="alert('Your message has been sent successfully! Purab will contact you soon.'); window.location.href='/contact'; return false;"  class="btn github">Submit</button></center>
      </div>
    </form>
  </div>

  <div class="contact-details text-light">
    <center>
        <p>
      purab.work1223@gmail.com<br>
      +1 (437) 799-1210
    </p>

    <p>
      197 Johnson Street<br>
      Barrie, Ontario
    </p>
    </center>

    <p><span class="followme"><center><b>Follow me</b></center></span></p>
    <ul class="list-unstyled d-flex justify-content-center gap-4">
      <li>
        <a href="https://www.instagram.com/purab_priyani/?utm_source=ig_web_button_share_sheet" target="_blank">
          <i class="fa-brands fa-instagram fa-lg"></i>
        </a>
      </li>
      <li>
        <a href="https://www.facebook.com/share/1BL6T7EyqF/?mibextid=wwXIfr" target="_blank">
          <i class="fa-brands fa-facebook-f fa-lg"></i>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/search/results/all/?fetchDeterministicClustersOnly=true&heroEntityKey=urn%3Ali%3Afsd_profile%3AACoAAEjiYusBYSK7M1SF6IXQ7nE62T_9fzEDCOU&keywords=purab%20priyani&origin=RICH_QUERY_SUGGESTION&position=2&searchId=63b509bc-e570-47bd-8fe0-f318ee1bf4da&sid=M!f&spellCorrectionEnabled=false"
          target="_blank">
