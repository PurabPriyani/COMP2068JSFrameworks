<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="bg-light">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Lost & Found Portal</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/items">Public Items</a>
                    </li>

                    {{#if user}}
                        <li class="nav-item">
                            <a class="nav-link" href="/items/my">My Items</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-warning" href="/auth/logout">Logout</a>
                        </li>

                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    {{/if}}

                </ul>

            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main class="container mt-4 mb-5">
        {{{body}}}
    </main>

    <!-- FOOTER -->
    <footer class="text-white py-3 text-center fixed-bottom">
        <p class="mb-0">&copy; {{year}} Campus Lost & Found Portal</p>
    </footer>

    <!-- Bootstrap Script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
