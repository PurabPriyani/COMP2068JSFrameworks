<h2 class="fw-bold text-danger mb-4">Delete Item</h2>

<div class="card p-4 shadow">

    <p class="lead">Are you sure you want to delete this item?</p>

    <h4 class="fw-bold">{{item.itemName}}</h4>

    <form method="POST">

        <button class="btn btn-danger mt-3">Yes, Delete</button>
        <a href="/items/my" class="btn btn-secondary mt-3">Cancel</a>

    </form>

</div>