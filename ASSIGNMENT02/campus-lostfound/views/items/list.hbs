<h2 class="mb-4 fw-bold">All Lost & Found Items</h2>

<form action="/search" method="GET" class="input-group mb-4">
    <input type="text" class="form-control" name="q" placeholder="Search by item name..." required>
    <button class="btn btn-primary">Search</button>
</form>

<div class="row">
    {{#each items}}
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">

                {{#if image}}
                    <img src="/uploads/{{image}}" class="card-img-top" style="height:250px; object-fit:cover;">
                {{else}}
                    <img src="/images/no-image.png" class="card-img-top">
                {{/if}}

                <div class="card-body">
                    <h5 class="card-title fw-bold">{{itemName}}</h5>

                    <p class="mb-1"><strong>Location:</strong> {{location}}</p>
                    <p class="mb-1"><strong>Date:</strong> {{date}}</p>

                    <p class="small text-muted">{{description}}</p>

                </div>
            </div>
        </div>
    {{/each}}
</div>
