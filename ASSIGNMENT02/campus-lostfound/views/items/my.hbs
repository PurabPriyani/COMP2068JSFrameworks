<h2 class="fw-bold mb-4">My Posted Items</h2>

<a href="/items/add" class="btn btn-success mb-3">+ Add New Item</a>

<div class="row">
    {{#each items}}
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">

                {{#if image}}
                    <img src="/uploads/{{image}}" class="card-img-top" style="height:220px; object-fit:cover;">
                {{/if}}

                <div class="card-body">

                    <h5 class="fw-bold">{{itemName}}</h5>

                    <p><strong>Location:</strong> {{location}}</p>

                    <a href="/items/edit/{{_id}}" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/items/delete/{{_id}}" class="btn btn-danger btn-sm">Delete</a>

                </div>
            </div>
        </div>
    {{/each}}
</div>
